# Variables de entorno para ClinData
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees el archivo .env

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=clindata

# Proveedor de IA (por ahora solo "anthropic")
AI_PROVIDER=anthropic

# Modo desarrollo: respuesta mock sin consumir API
MOCK_AI=true

# Anthropic
ANTHROPIC_API_KEY=sk-ant-PON-AQUI-TU-KEY
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
AI_MAX_TOKENS=4096
